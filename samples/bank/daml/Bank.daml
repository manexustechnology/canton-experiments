module Bank where

template BankAccount
  with
    bank : Party
    accountOwner : Party
    balance : Numeric 2
  where
    signatory bank
    observer accountOwner
    key (bank, accountOwner) : (Party, Party)
    maintainer key._1

    choice Deposit : ContractId BankAccount
      with
        amount : Numeric 2
      controller accountOwner
      do
        create this with balance = balance + amount

    choice Withdraw : ContractId BankAccount
      with
        amount : Numeric 2
      controller accountOwner
      do
        assertMsg "Insufficient funds" (balance >= amount)
        create this with balance = balance - amount

    nonconsuming choice Transfer : (ContractId BankAccount, ContractId BankAccount)
      with
        to : Party
        amount : Numeric 2
      controller bank
      do
        assertMsg "Insufficient funds" (balance >= amount)
        assertMsg "Cannot transfer to same account" (to /= accountOwner)

        receiverCid <- fst <$> fetchByKey @BankAccount (bank, to)
        receiverAccount <- fetch receiverCid

        archive self
        archive receiverCid

        senderCid <- create this with balance = balance - amount

        newReceiverCid <- create receiverAccount with
          balance = receiverAccount.balance + amount

        return (senderCid, newReceiverCid)

template BankService
  with
    bank : Party
    customers : [Party]
  where
    signatory bank
    observer customers

    nonconsuming choice OpenAccount : ContractId BankAccount
      with
        accountOwner : Party
      controller bank
      do
        existing <- lookupByKey @BankAccount (bank, accountOwner)
        case existing of
          Some cid -> return cid
          None ->
            create BankAccount with
              bank
              accountOwner
              balance = 0.0

    nonconsuming choice PayReward : ContractId BankAccount
      with
        accountCid : ContractId BankAccount
        reward : Numeric 2
      controller bank
      do
        account <- fetch accountCid
        archive accountCid
        create account with balance = account.balance + reward

    nonconsuming choice TransferAtoB : (ContractId BankAccount, ContractId BankAccount)
      with
        from : Party
        to : Party
        amount : Numeric 2
      controller bank
      do
        assertMsg "Cannot transfer to same account" (from /= to)

        senderCid <- fst <$> fetchByKey @BankAccount (bank, from)
        senderAccount <- fetch senderCid

        receiverCid <- fst <$> fetchByKey @BankAccount (bank, to)
        receiverAccount <- fetch receiverCid

        assertMsg "Insufficient funds" (senderAccount.balance >= amount)

        archive senderCid
        archive receiverCid

        newSenderCid <- create senderAccount with
          balance = senderAccount.balance - amount

        newReceiverCid <- create receiverAccount with
          balance = receiverAccount.balance + amount

        return (newSenderCid, newReceiverCid)
