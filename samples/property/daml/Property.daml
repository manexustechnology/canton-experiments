module Property where

template PropertyAccount
  with
    service : Party
    propertyOwner : Party
    contractLink : Text
    balance : Numeric 2
  where
    signatory service
    observer propertyOwner

    key (service, propertyOwner) : (Party, Party)
    maintainer key._1

    choice Deposit : ContractId PropertyAccount
      with
        amount : Numeric 2
      controller propertyOwner
      do
        create this with balance = balance + amount

    choice Withdraw : ContractId PropertyAccount
      with
        amount : Numeric 2
      controller propertyOwner
      do
        assertMsg "Insufficient funds" (balance >= amount)
        create this with balance = balance - amount

    nonconsuming choice TransferBalance
      : (ContractId PropertyAccount, ContractId PropertyAccount)
      with
        to : Party
        amount : Numeric 2
      controller service
      do
        assertMsg "Insufficient funds" (balance >= amount)
        assertMsg "Cannot transfer to same owner" (to /= propertyOwner)

        receiverCid <- fst <$> fetchByKey @PropertyAccount (service, to)
        receiverAccount <- fetch receiverCid

        archive self
        archive receiverCid

        senderCid <- create this with balance = balance - amount

        newReceiverCid <- create receiverAccount with
          balance = receiverAccount.balance + amount

        return (senderCid, newReceiverCid)

template PropertyService
  with
    service : Party
    owners : [Party]
  where
    signatory service
    observer owners

    nonconsuming choice CreatePropertyAccount : ContractId PropertyAccount
      with
        propertyOwner : Party
        contractLink : Text
        initialBalance : Numeric 2
      controller service
      do
        existing <- lookupByKey @PropertyAccount (service, propertyOwner)
        case existing of
          Some cid -> return cid
          None ->
            create PropertyAccount with
              service
              propertyOwner
              contractLink
              balance = initialBalance

    nonconsuming choice RewardPropertyOwner : ContractId PropertyAccount
      with
        accountCid : ContractId PropertyAccount
        reward : Numeric 2
      controller service
      do
        account <- fetch accountCid
        archive accountCid
        create account with balance = account.balance + reward
