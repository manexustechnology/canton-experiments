# Live wiring to the HOSTED Tenzro node (the participant the auction DAR
# was uploaded to), driven through the official Tenzro TS SDK
# (`tenzro-sdk`). This is the "use the SDK" path — contrast with
# .env.canton.local, which points the raw JSON-API adapter at a
# co-located participant.
#
# Next.js does not auto-load this file. Copy it to .env.local (or export
# the vars in your shell) before `bun run dev`:
#   cp .env.tenzro.local .env.local

# Force the SDK-backed backend. (Auto-selected anyway once TENZRO_API_KEY
# is set, but explicit is clearer for a sample.)
LEDGER_BACKEND=tenzro

# Tenzro JSON-RPC endpoint that fronts the Canton participant.
TENZRO_RPC_ENDPOINT=https://rpc.tenzro.network

# Operator-issued API key, scope `canton`. Forwarded by the SDK as
# X-Tenzro-Api-Key. Server-side only — never expose to the browser.
TENZRO_API_KEY=tnz_REPLACE_ME

# DAR package name → template id (#<pkg>:Auction:Auction). The uploaded
# DAR's daml.yaml `name:` is "auction".
CANTON_PACKAGE=auction

# Party ids on the hosted node (namespace fingerprint from the deployed
# participant; see AUCTION_FINDINGS.md). The current SDK has no `act_as`,
# so every command acts as the node's own API-key party — by default the
# created auction's `seller` is that party (resolved via getMyUser). Set
# CANTON_PARTY_SELLER only to override it.
#
# NS=1220ed9c20663dfc3b6180d5dd879ba3d7063a68b0016e26ba2549a9ae61ee0247b4
# CANTON_PARTY_SELLER=tenzro-validator-1::1220ed9c...0247b4
# CANTON_PARTY_BOB=Bob::1220ed9c...0247b4
# CANTON_PARTY_CHARLIE=Charlie::1220ed9c...0247b4
