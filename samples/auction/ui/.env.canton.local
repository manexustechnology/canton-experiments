# Live Canton sandbox wiring (local). Party ids discovered from the
# running participant via GET /v2/parties — all share one namespace
# fingerprint. No JWT: the dev sandbox runs with auth disabled.
CANTON_PARTICIPANT_HOST=localhost
CANTON_JSON_API_PORT=7575
CANTON_PACKAGE=auction
CANTON_APP_ID=tenzro-auction-app

CANTON_PARTY_SELLER=Seller::12205e6d102fb20b87d7250f65da34fbc4fd24af086e69e297aea53509936ca31c59
CANTON_PARTY_ALICE=Alice::12205e6d102fb20b87d7250f65da34fbc4fd24af086e69e297aea53509936ca31c59
CANTON_PARTY_BOB=Bob::12205e6d102fb20b87d7250f65da34fbc4fd24af086e69e297aea53509936ca31c59
CANTON_PARTY_CHARLIE=Charlie::12205e6d102fb20b87d7250f65da34fbc4fd24af086e69e297aea53509936ca31c59
