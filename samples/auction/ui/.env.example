# Leave CANTON_PARTICIPANT_HOST unset to run against the built-in
# in-memory mock ledger (no Canton participant required).
#
# Set it to talk to a real Canton participant over its JSON Ledger API
# v2 — the same wire format Tenzro's CantonAdapter uses
# (tenzro-network/crates/tenzro-bridge/src/canton.rs). Field names below
# mirror Tenzro's CantonConfig.

# Participant host (co-located, typically localhost).
# CANTON_PARTICIPANT_HOST=localhost

# JSON Ledger API port (Canton 3.x default 7575).
# CANTON_JSON_API_PORT=7575

# Use https instead of http.
# CANTON_TLS=false

# JWT authorizing actAs for the auction parties. Per-party tokens:
# CANTON_JWT_SELLER, CANTON_JWT_ALICE, CANTON_JWT_BOB, CANTON_JWT_CHARLIE.
# CANTON_JWT=

# Application/user id used as Canton's command-dedup key.
# CANTON_APP_ID=tenzro-auction-app

# DAR package name → template id (#<pkg>:Auction:Auction).
# Defaults to "auction" (the daml.yaml `name`).
# CANTON_PACKAGE=auction

# Map friendly party names → on-ledger "name::fingerprint" ids when your
# participant allocates namespaced parties.
# CANTON_PARTY_SELLER=Seller::1220abc...
# CANTON_PARTY_ALICE=Alice::1220abc...
# CANTON_PARTY_BOB=Bob::1220abc...
# CANTON_PARTY_CHARLIE=Charlie::1220abc...
