module Main where

import Daml.Script
import Property


setup : Script ()
setup = script do

  -- allocate parties
  service <- allocatePartyWithHint "PropertyService" (PartyIdHint "PropertyService1")
  aliceParty <- allocatePartyWithHint "Alice" (PartyIdHint "Alice")
  bobParty <- allocatePartyWithHint "Bob" (PartyIdHint "Bob")
  charlieParty <- allocatePartyWithHint "Charlie" (PartyIdHint "Charlie")


  -- validate user IDs
  serviceId <- validateUserId "service"
  aliceId <- validateUserId "alice"
  bobId <- validateUserId "bob"
  charlieId <- validateUserId "charlie"


  -- create users
  createUser (User serviceId (Some service)) [CanActAs service]

  createUser (User aliceId (Some aliceParty)) [CanActAs aliceParty]
  createUser (User bobId (Some bobParty)) [CanActAs bobParty]
  createUser (User charlieId (Some charlieParty)) [CanActAs charlieParty]


  -- create PropertyService contract
  submit service do
    createCmd PropertyService with
      service
      owners = [aliceParty, bobParty, charlieParty]


  return ()